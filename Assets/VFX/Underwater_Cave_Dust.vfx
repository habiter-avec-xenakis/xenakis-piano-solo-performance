      \t\t\n\t\t    \n\t\t    #include \"Packages/com.unity.shadergraph/ShaderGraphLibrary/Functions.hlsl\"\n\t\t   
      // Node: Flipbook\n\t\t    void Unity_Flipbook_float (float2 UV, float Width,
      float Height, float Tile, float2 Invert, out float2 Out)\n\t\t    {\n\t\t       
      Tile = fmod(Tile, Width*Height);\n\t\t        float2 tileCount = float2(1.0,
      1.0) / float2(Width, Height);\n\t\t        float tileY = abs(Invert.y * Height
      - (floor(Tile * tileCount.x) + Invert.y * 1));\n\t\t        float tileX = abs(Invert.x
      * Width - ((Tile - Width * floor(Tile * tileCount.x)) + Invert.x * 1));\n\t\t       
      Out = (UV + float2(tileX, tileY)) * tileCount;\n\t\t    }\n\t\t    \n\t\t   
