      = Smoothness;\n\t\t    \n\t\t        // Visual Effect Master\n\t\t        SG_Output_3258c607b4b87d547918b9c906976f3c
      OUT;\n\t\t        OUT.BaseColor_1 = (_Multiply_B9D252DF_Out_2.xyz);\n\t\t       
      OUT.Metallic_2 = _Property_2C82B95F_Out_0;\n\t\t        OUT.Smoothness_3 =
      _Property_C2A609E_Out_0;\n\t\t        OUT.Normal_8 = float3 (0, 0, 1);\n\t\t       
