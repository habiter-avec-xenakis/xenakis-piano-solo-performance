      VFX_SHADERGRAPH\n\t\t\t\t\t\n\t\t\t\t\tvoid VFXGetHDRPLitData(out SurfaceData
      surfaceData, out BuiltinData builtinData, out BSDFData bsdfData, out PreLightData
