            "JSONnodeData": "{\n    \"m_GuidSerialized\": \"e498f40f-1dc0-4aed-b5d7-fac99761f39b\",\n    \"m_GroupGuidSerialized\": \"00000000-0000-0000-0000-000000000000\",\n    \"m_Name\": \"Custom Function\",\n    \"m_NodeVersion\": 0,\n    \"m_DrawState\": {\n        \"m_Expanded\": true,\n        \"m_Position\": {\n            \"serializedVersion\": \"2\",\n            \"x\": -2208.0,\n            \"y\": -277.9999694824219,\n            \"width\": 208.0,\n            \"height\": 326.0\n        }\n    },\n    \"m_SerializableSlots\": [\n        {\n            \"typeInfo\": {\n                \"fullName\": \"UnityEditor.ShaderGraph.Vector2MaterialSlot\"\n            },\n            \"JSONnodeData\": \"{\\n    \\\"m_Id\\\": 0,\\n    \\\"m_DisplayName\\\": \\\"UV\\\",\\n    \\\"m_SlotType\\\": 0,\\n    \\\"m_Priority\\\": 2147483647,\\n    \\\"m_Hidden\\\": false,\\n    \\\"m_ShaderOutputName\\\": \\\"UV\\\",\\n    \\\"m_StageCapability\\\": 3,\\n    \\\"m_Value\\\": {\\n        \\\"x\\\": 0.0,\\n        \\\"y\\\": 0.0\\n    },\\n    \\\"m_DefaultValue\\\": {\\n        \\\"x\\\": 0.0,\\n        \\\"y\\\": 0.0\\n    },\\n    \\\"m_Labels\\\": [\\n        \\\"X\\\",\\n        \\\"Y\\\"\\n    ]\\n}\"\n        },\n        {\n            \"typeInfo\": {\n                \"fullName\": \"UnityEditor.ShaderGraph.Vector1MaterialSlot\"\n            },\n            \"JSONnodeData\": \"{\\n    \\\"m_Id\\\": 1,\\n    \\\"m_DisplayName\\\": \\\"AngleOffset\\\",\\n    \\\"m_SlotType\\\": 0,\\n    \\\"m_Priority\\\": 2147483647,\\n    \\\"m_Hidden\\\": false,\\n    \\\"m_ShaderOutputName\\\": \\\"AngleOffset\\\",\\n    \\\"m_StageCapability\\\": 3,\\n    \\\"m_Value\\\": 2.109999895095825,\\n    \\\"m_DefaultValue\\\": 0.0,\\n    \\\"m_Labels\\\": [\\n        \\\"X\\\"\\n    ]\\n}\"\n        },\n        {\n            \"typeInfo\": {\n                \"fullName\": \"UnityEditor.ShaderGraph.Vector1MaterialSlot\"\n            },\n            \"JSONnodeData\": \"{\\n    \\\"m_Id\\\": 2,\\n    \\\"m_DisplayName\\\": \\\"CellDensity\\\",\\n    \\\"m_SlotType\\\": 0,\\n    \\\"m_Priority\\\": 2147483647,\\n    \\\"m_Hidden\\\": false,\\n    \\\"m_ShaderOutputName\\\": \\\"CellDensity\\\",\\n    \\\"m_StageCapability\\\": 3,\\n    \\\"m_Value\\\": 5.739999771118164,\\n    \\\"m_DefaultValue\\\": 0.0,\\n    \\\"m_Labels\\\": [\\n        \\\"X\\\"\\n    ]\\n}\"\n        },\n        {\n            \"typeInfo\": {\n                \"fullName\": \"UnityEditor.ShaderGraph.Vector3MaterialSlot\"\n            },\n            \"JSONnodeData\": \"{\\n    \\\"m_Id\\\": 3,\\n    \\\"m_DisplayName\\\": \\\"Out\\\",\\n    \\\"m_SlotType\\\": 1,\\n    \\\"m_Priority\\\": 2147483647,\\n    \\\"m_Hidden\\\": false,\\n    \\\"m_ShaderOutputName\\\": \\\"Out\\\",\\n    \\\"m_StageCapability\\\": 3,\\n    \\\"m_Value\\\": {\\n        \\\"x\\\": 0.0,\\n        \\\"y\\\": 0.0,\\n        \\\"z\\\": 0.0\\n    },\\n    \\\"m_DefaultValue\\\": {\\n        \\\"x\\\": 0.0,\\n        \\\"y\\\": 0.0,\\n        \\\"z\\\": 0.0\\n    },\\n    \\\"m_Labels\\\": [\\n        \\\"X\\\",\\n        \\\"Y\\\",\\n        \\\"Z\\\"\\n    ]\\n}\"\n        }\n    ],\n    \"m_Precision\": 0,\n    \"m_PreviewExpanded\": true,\n    \"m_CustomColors\": {\n        \"m_SerializableColors\": []\n    },\n    \"m_SourceType\": 1,\n    \"m_FunctionName\": \"Voronoi2\",\n    \"m_FunctionSource\": \"\",\n    \"m_FunctionBody\": \"$precision2 n = floor(UV * CellDensity);\\r\\n$precision2 f = frac(UV * CellDensity);\\r\\n\\r\\n// first pass: regular voronoi\\r\\n$precision2 mg, mr;\\r\\n$precision md = 8.0;\\r\\nfor (int j= -1; j <= 1; j++) {\\r\\n    for (int i= -1; i <= 1; i++) {\\r\\n        $precision2 g = $precision2(i,j);\\r\\n\\r\\n        $precision2x2 m = $precision2x2(15.27, 47.63, 99.41, 89.98);\\r\\n        $precision2 uvr = frac(sin(mul(g+n, m)) * 46839.32);\\r\\n        $precision2 o = $precision2(sin(uvr.y*+AngleOffset)*0.5+0.5, cos(uvr.x*AngleOffset)*0.5+0.5);\\r\\n\\r\\n        $precision2 r = g + o - f;\\r\\n        $precision d = dot(r,r);\\r\\n\\r\\n        if( d<md ) {\\r\\n            md = d;\\r\\n            mr = r;\\r\\n            mg = g;\\r\\n        }\\r\\n    }\\r\\n}\\r\\n\\r\\n// second pass: distance to borders\\r\\nmd = 8.0;\\r\\nfor (int j= -2; j <= 2; j++) {\\r\\n    for (int i= -2; i <= 2; i++) {\\r\\n        $precision2 g = mg + $precision2(i,j);\\r\\n        $precision2x2 m = $precision2x2(15.27, 47.63, 99.41, 89.98);\\r\\n        $precision2 uvr = frac(sin(mul(g+n, m)) * 46839.32);\\r\\n        $precision2 o = $precision2(sin(uvr.y*+AngleOffset)*0.5+0.5, cos(uvr.x*AngleOffset)*0.5+0.5);\\r\\n\\r\\n        $precision2 r = g + o - f;\\r\\n\\r\\n        if ( dot(mr-r,mr-r)>0.0001 ) {\\r\\n            md = min(md, dot( 0.5*(mr+r), normalize(r-mr) ));\\r\\n        }\\r\\n    }\\r\\n}\\r\\n\\r\\nOut = $precision3(md, mr.x, mr.y);\"\n}"
        },
